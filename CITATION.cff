    family-names: "Do Nhat"
    affiliation: "Faculty of Data Science in Business, Ho Chi Minh University of Banking, Ho Chi Minh City, Vietnam"
    email: "linhdn@hub.edu.vn"
    # TODO(release): them orcid: "https://orcid.org/0000-0000-0000-0000"
